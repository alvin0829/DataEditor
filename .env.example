# Environment Configuration Example
# Copy this to .env and customize, or let deploy.bat generate it automatically.
#
# IMPORTANT: Never commit .env to version control!

# PostgreSQL Configuration
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# API Configuration
# Port the API is exposed on the host (default: 8080)
# LAN access: http://<server-ip>:API_PORT
API_PORT=8080
API_BIND_ADDRESS=127.0.0.1

# LDAP username authentication (values supplied by your directory administrator)
# Users sign in with a short username, such as dicky. By default the application
# builds the DN as uid=<username>,<LDAP_USER_BASE_DN>. Set LDAP_USER_DN_TEMPLATE
# only if your directory uses a different RDN (e.g. cn) or places users elsewhere.
# Use ldaps:// whenever the directory supports it. This application does not
# implement LDAP StartTLS.
AUTH_MODE=ldap
LDAP_SERVER_URI=ldaps://ldap.example.com:636
LDAP_USER_BASE_DN=dc=shingwo,dc=com
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=shingwo,dc=com
LDAP_ADMIN_GROUP_DN=cn=dataedit-admins,ou=groups,dc=shingwo,dc=com
# Optional: search base for posix/group membership beyond memberOf.
# LDAP_GROUP_BASE_DN=ou=groups,dc=shingwo,dc=com
# Optional: JSON mapping sheet keys to group/department rules.
# Supported keys: xxx, settings.  Matching is case-insensitive.
# LDAP_SHEET_ACCESS_JSON={"xxx":{"groups":["cn=xxx-editors,ou=groups,dc=shingwo,dc=com"],"departments":["maintenance"]},"settings":{"groups":["cn=settings-editors,ou=groups,dc=shingwo,dc=com"]}}
LDAP_CONNECT_TIMEOUT_SECONDS=5
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true

